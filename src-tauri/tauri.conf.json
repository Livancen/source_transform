{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "source_transform",
  "version": "8.2.1",
  "identifier": "com.tauri-app.source-transform",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "素材转换工具",
        "width": 1600,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/magick"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0QTFFRkY0QjhBMTM3QTIKUldTaU42RzQ5TytobE1UUUJRc2JrOUpzWG45T2lGYzFTSFMyT0FlQTdoUFJrMEh2Y2FGM3dHdW4K",
      "endpoints": [
        "https://github.com/Livancen/source_transform/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
